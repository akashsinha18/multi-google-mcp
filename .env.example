# Google OAuth client (Web application type)
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Public URL of this server, no trailing slash
BASE_URL=http://localhost:8080
# Fernet key: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENC_KEY=
# Comma-separated Google identities allowed to use the MCP endpoint and /accounts
ALLOWED_EMAILS=you@gmail.com
# Optional
DATA_DIR=./data
# JWT_SIGNING_KEY=           # signs MCP tokens; defaults to a key derived from the client secret
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# SQLITE_JOURNAL_MODE=WAL    # use DELETE on network filesystems (Cloud Run volume mounts)
# LOG_LEVEL=INFO
PORT=8080
